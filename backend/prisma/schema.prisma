// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  level     Int       @default(1)
  xp        Int       @default(0)
  coins     Int       @default(0)
  createdAt DateTime  @default(now())

  habits    Habit[]
  missions  Mission[]
  rewards   Reward[]
  purchases Purchase[]
  rewardOverrides RewardOverride[]
  motivation Motivation?
  data       UserData[]

  @@map("users")
}

model Habit {
  id        String   @id @default(uuid())
  title     String
  progress  Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("habits")
}

model Mission {
  id          String   @id @default(uuid())
  title       String
  description String
  xpReward    Int
  coinsReward Int
  completed   Boolean  @default(false)
  /// Quando foi cumprida (preenchido ao cumprir, apagado ao desfazer); usado nas métricas semanais da Evolução
  completedAt DateTime?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("missions")
}

model Reward {
  id          String     @id @default(uuid())
  title       String
  description String?
  price       Int
  available   Boolean    @default(true)
  /// Chave estável dos itens fixos da vitrine (ex.: "fixo-doce"); nula nas recompensas criadas pelo usuário
  key         String?    @unique
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  purchases   Purchase[]
  overrides RewardOverride[]

  @@map("rewards")
}

/// Histórico de compras da loja: guarda título e preço do momento da compra
model Purchase {
  id        String    @id @default(uuid())
  title     String
  price     Int
  used      Boolean   @default(false)
  usedAt    DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId  String?
  reward    Reward?   @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("purchases")
}

/// Personal edits to shared showcase items, without changing the global catalog.
model RewardOverride {
  userId String
  rewardId String
  title String?
  description String?
  price Int?
  hidden Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  @@id([userId, rewardId])
  @@map("reward_overrides")
}

/// Motivação principal do jogador (frase do quadro-negro e foto do porta-retrato na Evolução).
/// A foto fica no Supabase Storage (bucket privado "motivation-photos"); aqui guardamos só o caminho dela.
model Motivation {
  userId    String   @id
  text      String   @default("")
  /// Caminho do arquivo no bucket, sempre dentro da pasta do usuário: "<userId>/<arquivo>.jpg"
  photoPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("motivations")
}

/// Dados que o jogador coloca no site (metas e registro diário, diário, baús, perfil, preferências...).
/// Um registro por chave do navegador ("farminghabit.goals.v1" etc.), com o conteúdo como texto JSON.
/// O front sincroniza: baixa ao abrir e envia cada mudança; o mais recente (updatedAt) vence.
model UserData {
  userId    String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, key])
  @@map("user_data")
}
