# Cole a conexão PostgreSQL do painel Connect do Supabase (não a URL HTTP da API).
# Runtime: conexão direta/session pooler, ou transaction pooler com ?pgbouncer=true.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres?sslmode=require"
# Migrations: conexão direta ou session pooler (porta 5432), nunca transaction pooler.
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres?sslmode=require"
PORT=3000
