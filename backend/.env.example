# Cole a conexão PostgreSQL do painel Connect do Supabase (não a URL HTTP da API).
# Prefira o pooler em session mode (aws-0-<região>.pooler.supabase.com:5432, usuário postgres.<projeto>):
# o endereço direto db.<projeto>.supabase.co é só IPv6 e não conecta em redes sem IPv6 (erro P1001).
# Senha com caracteres especiais (@, #, !...) precisa ir codificada na URL (encodeURIComponent).
# Runtime: conexão direta/session pooler, ou transaction pooler com ?pgbouncer=true.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres?sslmode=require"
# Migrations: conexão direta ou session pooler (porta 5432), nunca transaction pooler.
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres?sslmode=require"
PORT=3000
# Supabase Storage (fotos da motivação): URL do projeto (https://<ref>.supabase.co) e a chave service_role
# do painel Project Settings → API. A service_role é secreta: fica só aqui no backend, nunca no frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Só para projetos antigos que assinam o login com HS256 (Settings → API → JWT Secret). Projetos novos não precisam.
SUPABASE_JWT_SECRET=
